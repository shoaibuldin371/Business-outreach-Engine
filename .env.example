# =========================================================================
# Business Outreach Engine — Environment Variables Configuration
# =========================================================================

# 1. Supabase Database & Auth (Mandatory for real-time cloud data sync)
# Find these in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Gmail OAuth 2.0 Integration (Recommended for secure 1-click email dispatch)
# Create OAuth Credentials in Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI should be https://your-domain.vercel.app/api/auth/gmail/callback
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=https://business-outreach-engine.vercel.app/api/auth/gmail/callback

# 3. Business Discovery & Web Verification Search APIs
# Brave Search API: https://brave.com/search/api/ (Recommended for web presence & verification)
BRAVE_SEARCH_API_KEY=
# Google Places API (New): (Optional alternative for business discovery)
GOOGLE_PLACES_API_KEY=

# 4. AI Personalized Email Copywriting
# Anthropic Claude API (Recommended): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Alternative LLM providers supported:
GEMINI_API_KEY=
OPENAI_API_KEY=

# 5. Autonomous Scheduler Security (Vercel Cron & External Webhooks)
# Secure secret to protect /api/automation/run from unauthorized requests
CRON_SECRET=business-outreach-engine-secure-cron-token-3h

# 6. Admin & Outreach Profile Settings
ADMIN_EMAIL=Mshoaibawan371@gmail.com
SENDER_NAME=Muhammad Shoaib
SENDER_EMAIL=Mshoaibawan371@gmail.com
SENDER_BUSINESS=Web Development & Client Acquisition

# 7. Deployment Public URLs
NEXT_PUBLIC_APP_URL=https://business-outreach-engine.vercel.app

# 8. SMTP Fallback (Optional, if not using Gmail OAuth)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
