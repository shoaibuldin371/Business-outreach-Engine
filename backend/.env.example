# Business Outreach Engine - Backend Configuration

# Deployment URLs (Critical for Gmail HITL links)
# In Railway: Set BACKEND_PUBLIC_URL to your Railway app domain (e.g., https://your-backend.up.railway.app)
# In Vercel: Set FRONTEND_URL to your Vercel deployment domain (e.g., https://your-frontend.vercel.app)
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Supabase Credentials (from Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Admin Gmail for Human-In-The-Loop Approval Emails
ADMIN_EMAIL=your-gmail@gmail.com

# SMTP Settings (Gmail App Password or Resend / SendGrid / Amazon SES)
# If using Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=outreach@yourdomain.com
SENDER_NAME=Your Agency Name

# Optional: Google Places API (New) key for live text search discovery
GOOGLE_PLACES_API_KEY=

# 3-Hour Automation Config
AUTOMATION_INTERVAL_HOURS=3
DEFAULT_CATEGORY=dentists
DEFAULT_CITY=Dallas, TX
PORT=8000
